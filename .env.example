# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for Maps JS, Places (New), and Routes.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESIDENTIAL_PROXY_URL: Optional HTTP/HTTPS residential proxy URL for non-Google outbound server requests.
# Example: http://username:password@proxy-host:port
# Leave unset to route all outbound server requests directly.
RESIDENTIAL_PROXY_URL=""

# --- Optional Enterprise Connectors (Server-Side Only) ---
# Jira Enterprise (Cloud or Data Center)
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""
JIRA_PROJECT_KEY=""

# Salesforce REST API
SF_INSTANCE_URL=""
SF_ACCESS_TOKEN=""

# ServiceNow Table API (supports REST API Key via x-sn-apikey, Bearer <token>, or username:password)
SERVICENOW_INSTANCE_URL=""
SERVICENOW_API_TOKEN=""

# --- Enterprise API Auth & RBAC (Optional) ---
# Require verified Firebase Google Sign-In ID token on /api/enterprise/* (defaults to true when Firebase is configured)
ENTERPRISE_REQUIRE_AUTH="true"
# Optional comma-separated allowlist of authorized user emails or domains (leave empty to allow any signed-in user)
ENTERPRISE_ALLOWED_EMAILS=""
ENTERPRISE_ALLOWED_DOMAINS=""


